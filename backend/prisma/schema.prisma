datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum NotificationCategory {
  INFO
  WARNING
  URGENT
  SUCCESS
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  QR
  MANUAL
  OFFLINE_SYNC
}

model School {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  address      String
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  classes          Class[]
  students         Student[]
  notifications    Notification[]
  timetableEntries TimetableEntry[]
  academicEvents   AcademicEvent[]
  examinations     Examination[]
  studentLeaves    StudentLeave[]
  studentIncidents StudentIncident[]
  feeStructures    FeeStructure[]
  studentFees      StudentFee[]
  feePayments      FeePayment[]
  parents          Parent[]
  announcements    SchoolAnnouncement[]
  communicationMessages CommunicationMessage[]
  syncOperations   SyncOperation[]
  studentDocuments StudentDocument[]
  certificateTemplates CertificateTemplate[]
  issuedCertificates IssuedCertificate[]
  academicInterventions AcademicIntervention[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEACHER)
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  timetableEntries   TimetableEntry[]
  appliedLeaves      StudentLeave[]          @relation("LeaveApplicant")
  reviewedLeaves     StudentLeave[]          @relation("LeaveReviewer")
  leaveDecisions     StudentLeaveDecision[]
  reportedIncidents  StudentIncident[]       @relation("IncidentReporter")
  resolvedIncidents  StudentIncident[]       @relation("IncidentResolver")
  incidentActions    IncidentActionHistory[]
  recordedFeePayments FeePayment[]           @relation("FeeCollector")
  reversedFeePayments FeePayment[]           @relation("FeeReverser")
  approvedDiscounts  FeeDiscount[]           @relation("DiscountApprover")
  approvedReversals  PaymentReversal[]       @relation("ReversalApprover")
  parentProfile      Parent?
  authoredAnnouncements SchoolAnnouncement[] @relation("AnnouncementAuthor")
  sentMessages       CommunicationMessage[]  @relation("MessageSender")
  receivedMessages   CommunicationMessage[]  @relation("MessageReceiver")
  readAnnouncements  AnnouncementRead[]
  syncOperations     SyncOperation[]
  resolvedConflicts  SyncOperation[]         @relation("ConflictResolver")
  uploadedDocuments  StudentDocument[]       @relation("DocumentUploader")
  verifiedDocuments  StudentDocument[]       @relation("DocumentVerifier")
  uploadedDocVersions DocumentVersion[]      @relation("VersionUploader")
  createdCertTemplates CertificateTemplate[] @relation("TemplateCreator")
  issuedCertificates   IssuedCertificate[]   @relation("CertificateIssuer")
  revokedCertificates  IssuedCertificate[]   @relation("CertificateRevoker")
  createdInterventions AcademicIntervention[] @relation("InterventionCreator")
  assignedInterventions AcademicIntervention[] @relation("InterventionAssignee")
  resolvedInterventions AcademicIntervention[] @relation("InterventionResolver")
  interventionNotes    AcademicInterventionNote[]

  @@map("users")
}

model Class {
  id           String   @id @default(uuid())
  name         String // e.g., "Class 8"
  section      String // e.g., "A"
  academicYear String // e.g., "2026-2027"
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students           Student[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  examinations       Examination[]
  studentLeaves      StudentLeave[]
  studentIncidents   StudentIncident[]
  feeStructures      FeeStructure[]
  announcements      SchoolAnnouncement[]

  @@unique([schoolId, name, section, academicYear])
  @@map("classes")
}

model TeacherAssignment {
  id             String   @id @default(uuid())
  teacherId      String
  teacher        User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  isClassTeacher Boolean  @default(false)
  assignedAt     DateTime @default(now())

  @@unique([teacherId, classId])
  @@map("teacher_assignments")
}

model Student {
  id              String    @id @default(uuid())
  name            String
  admissionNumber String
  rollNumber      String?
  classId         String
  class           Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  qrToken         String    @unique @default(uuid())
  dateOfBirth     DateTime?
  gender          String? // "Male", "Female", "Other"
  guardianName    String?
  guardianPhone   String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attendanceRecords AttendanceRecord[]
  examMarks         ExamMark[]
  studentLeaves     StudentLeave[]
  studentIncidents  StudentIncident[]
  studentFees       StudentFee[]
  feePayments       FeePayment[]
  parentLinks       ParentStudent[]
  communicationMessages CommunicationMessage[]
  syncOperations    SyncOperation[]
  studentDocuments  StudentDocument[]
  issuedCertificates IssuedCertificate[]
  academicInterventions AcademicIntervention[]

  @@unique([schoolId, admissionNumber])
  @@index([classId])
  @@index([qrToken])
  @@map("students")
}

model AttendanceSession {
  id          String        @id @default(uuid())
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sessionDate DateTime      @default(now())
  status      SessionStatus @default(OPEN)
  notes       String?
  createdAt   DateTime      @default(now())
  closedAt    DateTime?

  attendanceRecords AttendanceRecord[]

  @@index([classId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  method    AttendanceMethod  @default(MANUAL)
  markedAt  DateTime          @default(now())
  remarks   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, markedAt])
  @@index([status])
  @@map("attendance_records")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String // e.g. "RECORD_UPDATED", "SESSION_CLOSED", "STUDENT_CREATED"
  entityType    String // e.g. "AttendanceRecord", "Student", "AttendanceSession"
  entityId      String
  previousValue String? // JSON representation
  newValue      String? // JSON representation
  reason        String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Notification {
  id         String               @id @default(uuid())
  schoolId   String
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  category   NotificationCategory @default(INFO)
  type       String               // "LOW_ATTENDANCE", "INCOMPLETE_SESSION", "STUDENT_ABSENCE", "GENERAL_ANNOUNCEMENT", "SYSTEM_ALERT"
  entityType String?              // "STUDENT", "CLASS", "SESSION", "TEACHER"
  entityId   String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([schoolId, userId, isRead])
  @@index([schoolId, category])
  @@index([schoolId, createdAt])
  @@map("notifications")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimetableEntry {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      String
  dayOfWeek    DayOfWeek
  startTime    String    // 24-hr format "HH:mm" e.g. "09:00"
  endTime      String    // 24-hr format "HH:mm" e.g. "09:45"
  roomNumber   String?   // optional room e.g. "Room 101"
  academicYear String?   // optional e.g. "2026-2027"
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId, classId, dayOfWeek])
  @@index([schoolId, teacherId, dayOfWeek])
  @@index([schoolId, dayOfWeek])
  @@map("timetable_entries")
}

enum AcademicEventType {
  HOLIDAY
  EXAM
  EVENT
  ACADEMIC
}

model AcademicEvent {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        AcademicEventType @default(EVENT)
  startDate   DateTime
  endDate     DateTime
  isHoliday   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId, startDate, endDate])
  @@index([schoolId, type])
  @@map("academic_events")
}

enum ExamType {
  UNIT_TEST
  MIDTERM
  FINAL
  PRACTICAL
  ASSESSMENT
}

model Examination {
  id           String        @id @default(uuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String        // e.g. "Term 1 Midterm Assessment", "Final Exam 2026"
  examType     ExamType      @default(MIDTERM)
  academicYear String        // e.g. "2026-2027"
  classId      String?
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  examSubjects ExamSubject[]

  @@index([schoolId, academicYear])
  @@index([schoolId, classId])
  @@map("examinations")
}

model ExamSubject {
  id            String      @id @default(uuid())
  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  subject       String      // e.g. "Mathematics", "Science", "English"
  maxMarks      Float       @default(100)
  passMarks     Float       @default(33)
  examDate      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  marks         ExamMark[]

  @@unique([examinationId, subject])
  @@map("exam_subjects")
}

model ExamMark {
  id            String      @id @default(uuid())
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

enum LeaveType {
  SICK
  FAMILY
  PERSONAL
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StudentLeave {
  id            String                 @id @default(uuid())
  schoolId      String
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  appliedById   String?
  appliedBy     User?                  @relation(name: "LeaveApplicant", fields: [appliedById], references: [id], onDelete: SetNull)
  leaveType     LeaveType              @default(SICK)
  startDate     DateTime
  endDate       DateTime
  totalDays     Int                    @default(1)
  reason        String
  documentUrl   String?
  status        LeaveStatus            @default(PENDING)
  reviewRemarks String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?                  @relation(name: "LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  decisions     StudentLeaveDecision[]

  @@index([schoolId, status])
  @@index([schoolId, classId, startDate])
  @@index([studentId, startDate, endDate])
  @@map("student_leaves")
}

model StudentLeaveDecision {
  id         String       @id @default(uuid())
  leaveId    String
  leave      StudentLeave @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  action     LeaveStatus  @default(APPROVED)
  remarks    String
  decidedAt  DateTime     @default(now())

  @@index([leaveId])
  @@map("student_leave_decisions")
}

enum IncidentCategory {
  BEHAVIOUR
  ATTENDANCE
  ACADEMIC
  SAFETY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model StudentIncident {
  id              String                  @id @default(uuid())
  schoolId        String
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId         String
  class           Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  reportedById    String?
  reportedBy      User?                   @relation(name: "IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  title           String
  description     String
  incidentDate    DateTime                @default(now())
  category        IncidentCategory        @default(BEHAVIOUR)
  severity        IncidentSeverity        @default(MEDIUM)
  status          IncidentStatus          @default(REPORTED)
  actionTaken     String?
  resolutionNotes String?
  isPrivate       Boolean                 @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?                   @relation(name: "IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  history         IncidentActionHistory[]

  @@index([schoolId, category, severity])
  @@index([schoolId, status])
  @@index([studentId, incidentDate])
  @@map("student_incidents")
}

model IncidentActionHistory {
  id         String          @id @default(uuid())
  incidentId String
  incident   StudentIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String          // "REPORTED", "STATUS_CHANGE", "ACTION_TAKEN", "RESOLVED", "NOTE_ADDED"
  notes      String?
  timestamp  DateTime        @default(now())

  @@index([incidentId])
  @@map("incident_action_history")
}

enum FeeCategory {
  TUITION
  TRANSPORT
  EXAMINATION
  LIBRARY
  DEVELOPMENT
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model FeeStructure {
  id           String       @id @default(uuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String?
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  name         String       // e.g. "Annual Tuition Fee 2026-2027"
  academicYear String       // e.g. "2026-2027"
  category     FeeCategory  @default(TUITION)
  totalAmount  Float        // base amount
  isOptional   Boolean      @default(false)
  frequency    String       @default("ANNUAL") // "ANNUAL", "TERMLY", "MONTHLY", "ONE_TIME"
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  studentFees  StudentFee[]

  @@index([schoolId, academicYear])
  @@index([schoolId, classId])
  @@map("fee_structures")
}

model StudentFee {
  id                String            @id @default(uuid())
  schoolId          String
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId    String
  feeStructure      FeeStructure      @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear      String
  originalAmount    Float
  discountAmount    Float             @default(0)
  scholarshipAmount Float             @default(0)
  netAmount         Float
  paidAmount        Float             @default(0)
  balanceAmount     Float
  status            PaymentStatus     @default(PENDING)
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  installments      FeeInstallment[]
  payments          FeePayment[]
  discounts         FeeDiscount[]

  @@unique([studentId, feeStructureId])
  @@index([schoolId, status])
  @@index([schoolId, academicYear])
  @@map("student_fees")
}

model FeeInstallment {
  id                String              @id @default(uuid())
  studentFeeId      String
  studentFee        StudentFee          @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  installmentNumber Int
  title             String              // e.g. "Installment 1"
  amount            Float
  dueDate           DateTime
  paidAmount        Float               @default(0)
  balanceAmount     Float
  status            PaymentStatus       @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  allocations       PaymentAllocation[]

  @@unique([studentFeeId, installmentNumber])
  @@index([studentFeeId, dueDate])
  @@map("fee_installments")
}

model FeePayment {
  id                   String              @id @default(uuid())
  schoolId             String
  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFeeId         String
  studentFee           StudentFee          @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receiptNumber        String              @unique
  amountPaid           Float
  paymentMethod        PaymentMethod       @default(CASH)
  transactionReference String?
  remarks              String?
  paymentDate          DateTime            @default(now())
  recordedById         String?
  recordedBy           User?               @relation(name: "FeeCollector", fields: [recordedById], references: [id], onDelete: SetNull)
  isReversed           Boolean             @default(false)
  reversedAt           DateTime?
  reversedById         String?
  reversedBy           User?               @relation(name: "FeeReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalReason       String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  allocations          PaymentAllocation[]
  reversals            PaymentReversal[]

  @@index([schoolId, paymentDate])
  @@index([studentId, paymentDate])
  @@index([receiptNumber])
  @@map("fee_payments")
}

model PaymentAllocation {
  id               String         @id @default(uuid())
  feePaymentId     String
  feePayment       FeePayment     @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  feeInstallmentId String
  feeInstallment   FeeInstallment @relation(fields: [feeInstallmentId], references: [id], onDelete: Cascade)
  allocatedAmount  Float
  createdAt        DateTime       @default(now())

  @@index([feePaymentId])
  @@index([feeInstallmentId])
  @@map("payment_allocations")
}

model FeeDiscount {
  id           String       @id @default(uuid())
  studentFeeId String
  studentFee   StudentFee   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  discountType DiscountType @default(FIXED_AMOUNT)
  value        Float
  amount       Float
  reason       String
  approvedById String?
  approvedBy   User?        @relation(name: "DiscountApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([studentFeeId])
  @@map("fee_discounts")
}

model PaymentReversal {
  id           String     @id @default(uuid())
  feePaymentId String
  feePayment   FeePayment @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  approvedById String?
  approvedBy   User?      @relation(name: "ReversalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reason       String
  reversedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([feePaymentId])
  @@map("payment_reversals")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ParentAccountStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  ATTENDANCE
  FEES
  EVENTS
  URGENT
}

enum AudienceType {
  ALL
  PARENTS
  TEACHERS
  CLASS
}

enum MessageCategory {
  GENERAL
  ACADEMIC
  ATTENDANCE
  FEES
  URGENT
}

model Parent {
  id             String               @id @default(uuid())
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianName   String
  relationship   GuardianRelationship @default(GUARDIAN)
  phone          String
  alternatePhone String?
  address        String?
  occupation     String?
  idProofNumber  String?
  status         ParentAccountStatus  @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  students       ParentStudent[]

  @@index([schoolId])
  @@index([phone])
  @@map("parents")
}

model ParentStudent {
  id               String               @id @default(uuid())
  parentId         String
  parent           Parent               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship     GuardianRelationship @default(GUARDIAN)
  isPrimaryContact Boolean              @default(true)
  canPickup        Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([parentId])
  @@map("parent_students")
}

model SchoolAnnouncement {
  id             String               @id @default(uuid())
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title          String
  content        String
  category       AnnouncementCategory @default(GENERAL)
  priority       String               @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"
  targetAudience AudienceType         @default(ALL)
  classId        String?
  class          Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  authorId       String
  author         User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  isPublished    Boolean              @default(true)
  publishedAt    DateTime             @default(now())
  scheduledFor   DateTime?
  attachmentUrl  String?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reads          AnnouncementRead[]

  @@index([schoolId, targetAudience])
  @@index([schoolId, category])
  @@index([schoolId, classId])
  @@index([schoolId, isPublished, publishedAt])
  @@map("school_announcements")
}

model AnnouncementRead {
  id             String             @id @default(uuid())
  announcementId String
  announcement   SchoolAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime           @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model CommunicationMessage {
  id            String          @id @default(uuid())
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  threadId      String?
  senderId      String
  sender        User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User            @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  subject       String
  content       String
  category      MessageCategory @default(GENERAL)
  isRead        Boolean         @default(false)
  readAt        DateTime?
  attachmentUrl String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([schoolId, senderId])
  @@index([schoolId, receiverId, isRead])
  @@index([threadId])
  @@index([studentId])
  @@map("communication_messages")
}

enum SyncOperationStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  CONFLICT
}

model SyncOperation {
  id           String              @id @default(uuid())
  schoolId     String
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  operationId  String              @unique
  studentId    String?
  student      Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  status       SyncOperationStatus @default(PENDING)
  action       String              @default("MARK_ATTENDANCE")
  payload      Json
  retryCount   Int                 @default(0)
  lastError    String?
  conflictData Json?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?               @relation("ConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  processedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([schoolId, status])
  @@index([teacherId, status])
  @@index([operationId])
  @@map("sync_operations")
}

enum DocumentCategory {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  IDENTITY_PROOF
  ADDRESS_PROOF
  ACADEMIC_RECORD
  MEDICAL_RECORD
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CertificateType {
  BONAFIDE
  TRANSFER
  CHARACTER
  STUDY
  FEE_CLEARANCE
  ACHIEVEMENT
  OTHER
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model StudentDocument {
  id                String                     @id @default(uuid())
  schoolId          String
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          DocumentCategory           @default(OTHER)
  status            DocumentVerificationStatus @default(PENDING)
  currentVersion    Int                        @default(1)
  filePath          String
  fileName          String
  fileSize          Int
  mimeType          String
  fileHash          String?
  issueDate         DateTime?
  expiryDate        DateTime?
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?                      @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes String?
  uploadedById      String
  uploadedBy        User                       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  versions          DocumentVersion[]

  @@index([schoolId, studentId])
  @@index([schoolId, category])
  @@index([schoolId, status])
  @@map("student_documents")
}

model DocumentVersion {
  id            String          @id @default(uuid())
  documentId    String
  document      StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  filePath      String
  fileName      String
  fileSize      Int
  mimeType      String
  fileHash      String?
  changeReason  String?
  uploadedById  String
  uploadedBy    User            @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model CertificateTemplate {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  type           CertificateType @default(BONAFIDE)
  title          String
  headerText     String?
  bodyTemplate   String
  footerText     String?
  signatoryTitle String          @default("Principal / Head of Institution")
  signatoryName  String?
  watermarkText  String?
  validityMonths Int?
  active         Boolean         @default(true)
  createdById    String
  createdBy      User            @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  issuedCertificates IssuedCertificate[]

  @@unique([schoolId, name])
  @@index([schoolId, type, active])
  @@map("certificate_templates")
}

model IssuedCertificate {
  id                String                      @id @default(uuid())
  schoolId          String
  school            School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId        String?
  template          CertificateTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  certificateNumber String                      @unique
  verificationToken String                      @unique @default(uuid())
  type              CertificateType
  title             String
  studentSnapshot   Json
  certificateData   Json
  signatoryTitle    String                      @default("Principal / Head of Institution")
  signatoryName     String?
  issueDate         DateTime                    @default(now())
  expiryDate        DateTime?
  status            CertificateStatus           @default(ACTIVE)
  issuedById        String
  issuedBy          User                        @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  revokedAt         DateTime?
  revokedById       String?
  revokedBy         User?                       @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revocationReason  String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  verificationLogs  CertificateVerificationLog[]

  @@index([schoolId, studentId])
  @@index([schoolId, type])
  @@index([schoolId, status])
  @@index([certificateNumber])
  @@index([verificationToken])
  @@map("issued_certificates")
}

model CertificateVerificationLog {
  id            String            @id @default(uuid())
  certificateId String
  certificate   IssuedCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  ipAddress     String?
  userAgent     String?
  verifiedAt    DateTime          @default(now())
  queryToken    String?
  isValid       Boolean           @default(true)

  @@index([certificateId])
  @@map("certificate_verification_logs")
}

enum InterventionType {
  ACADEMIC_DEFICIT
  EXAM_DECLINE
  ATTENDANCE_CORRELATION
  BEHAVIORAL
  SUBJECT_SPECIFIC
  OTHER
}

enum InterventionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CANCELLED
}

model AcademicIntervention {
  id                  String               @id @default(uuid())
  schoolId            String
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId           String
  teacher             User                 @relation("InterventionCreator", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedToId        String?
  assignedTo          User?                @relation("InterventionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  type                InterventionType     @default(ACADEMIC_DEFICIT)
  severity            InterventionSeverity @default(MEDIUM)
  status              InterventionStatus   @default(OPEN)
  title               String
  description         String
  subject             String?
  actionPlan          String?
  baselinePercentage  Float?
  targetPercentage    Float?
  currentPercentage   Float?
  baselineAttendance  Float?
  followUpDate        DateTime?
  resolvedAt          DateTime?
  resolvedById        String?
  resolvedBy          User?                @relation("InterventionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  notes               AcademicInterventionNote[]

  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, severity])
  @@map("academic_interventions")
}

model AcademicInterventionNote {
  id             String               @id @default(uuid())
  interventionId String
  intervention   AcademicIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  note           String
  progressMetric Float?
  createdAt      DateTime             @default(now())

  @@index([interventionId])
  @@map("academic_intervention_notes")
}
