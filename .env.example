# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikshatrack?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikshatrack_test?schema=public"

# Backend server
PORT=5050
NODE_ENV=development
JWT_SECRET="shikshatrack_super_secret_jwt_key_2026_rural_education"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# AI Provider Configuration (Optional - ShikshaTrack includes built-in intelligent fallback)
# Supported providers: gemini, openai, mock
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Offline sync secret
SYNC_SECRET="shiksha_sync_secure_token"
